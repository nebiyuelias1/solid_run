<div class="card" style="padding: 1.5rem;">
  <div style="display: flex; justify-content: space-between; align-items: flex-start;">
    <div>
      <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 0.5rem;">
        <span class="badge badge-<%= run.status %>" style="font-size: 0.9rem; padding: 0.35rem 0.8rem;">
          <%= run.status.tr('_', ' ') %>
        </span>
        <h1 style="margin: 0; font-size: 1.5rem; font-weight: 700;">
          <%= run.commit_message.presence || "Run ##{run.id}" %>
        </h1>
      </div>

      <div style="color: var(--text-muted); font-size: 0.9rem; display: flex; gap: 1.5rem; flex-wrap: wrap; margin-top: 0.75rem;">
        <div><strong>Repo:</strong> <%= run.repo %></div>
        <div><strong>Branch:</strong> <span style="font-family: monospace;"><%= run.branch || "main" %></span></div>
        <div><strong>Commit:</strong> <span style="font-family: monospace;"><%= run.short_sha %></span></div>
        <div><strong>Author:</strong> <%= run.author || "unknown" %></div>
        <div><strong>Duration:</strong> <span style="font-family: monospace;"><%= run.duration_display %></span></div>
      </div>
    </div>

    <div>
      <%= button_to "🔄 Re-run Workflow", rerun_run_path(run), method: :post, class: "btn btn-primary", data: { turbo_confirm: "Re-queue this workflow in Solid Queue?" } %>
    </div>
  </div>
</div>

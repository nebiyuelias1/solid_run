<!DOCTYPE html>
<html lang="en" class="dark">
  <head>
    <title><%= content_for(:title) || "Solid Run | Local CI" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= javascript_importmap_tags %>

    <style>
      :root {
        --bg-main: #0d1117;
        --bg-card: #161b22;
        --bg-header: #1c2128;
        --border: #30363d;
        --text-main: #c9d1d9;
        --text-muted: #8b949e;
        --accent: #58a6ff;
        --green: #238636;
        --green-text: #3fb950;
        --red: #da3633;
        --red-text: #f85149;
        --yellow: #d29922;
        --yellow-text: #e3b341;
      }
      body {
        margin: 0;
        background-color: var(--bg-main);
        color: var(--text-main);
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      }
      header {
        background-color: var(--bg-header);
        border-bottom: 1px solid var(--border);
        padding: 1rem 2rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
      }
      .container {
        max-width: 1200px;
        margin: 2rem auto;
        padding: 0 1rem;
      }
      .card {
        background-color: var(--bg-card);
        border: 1px solid var(--border);
        border-radius: 8px;
        overflow: hidden;
      }
      .badge {
        display: inline-flex;
        align-items: center;
        padding: 0.25rem 0.6rem;
        border-radius: 12px;
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
      }
      .badge-queued { background-color: #383e47; color: var(--text-muted); }
      .badge-in_progress { background-color: #5a4b16; color: var(--yellow-text); }
      .badge-success { background-color: #1b4b27; color: var(--green-text); }
      .badge-failure { background-color: #5c1d24; color: var(--red-text); }

      .table {
        width: 100%;
        border-collapse: collapse;
      }
      .table th, .table td {
        padding: 0.85rem 1rem;
        text-align: left;
        border-bottom: 1px solid var(--border);
      }
      .table th {
        background-color: var(--bg-header);
        color: var(--text-muted);
        font-size: 0.8rem;
        text-transform: uppercase;
      }
      .table tr:hover {
        background-color: rgba(255, 255, 255, 0.02);
      }
      a { color: var(--accent); text-decoration: none; }
      a:hover { text-decoration: underline; }
      .btn {
        background-color: var(--border);
        color: var(--text-main);
        padding: 0.4rem 0.8rem;
        border-radius: 6px;
        font-size: 0.85rem;
        border: 1px solid var(--border);
        cursor: pointer;
      }
      .btn:hover { background-color: #383e47; }
      .btn-primary { background-color: var(--green); color: white; border: none; }
      .btn-primary:hover { background-color: #2ea043; }
      .terminal {
        background-color: #030712;
        color: #f3f4f6;
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
        font-size: 0.85rem;
        line-height: 1.4;
        padding: 1rem;
        border-radius: 6px;
        white-space: pre-wrap;
        word-break: break-all;
        max-height: 650px;
        overflow-y: auto;
      }
    </style>
  </head>

  <body>
    <header>
      <div style="display: flex; align-items: center; gap: 0.75rem;">
        <span style="font-size: 1.5rem;">⚡</span>
        <a href="/" style="font-size: 1.25rem; font-weight: 700; color: white; text-decoration: none;">
          Solid Run <span style="font-size: 0.8rem; color: var(--text-muted); font-weight: 400;">Local CI</span>
        </a>
      </div>
      <div>
        <span class="badge badge-success">● Solid Queue Active</span>
      </div>
    </header>

    <main class="container">
      <%= yield %>
    </main>
  </body>
</html>
